# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/teenwallet
DATABASE_SSL=false            # set to true on Render
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# PayPal sandbox (use the US Business app's keys)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=            # optional, only needed for the webhook backup path

# Where PayPal sends the parent after approving or cancelling.
# Must be an https address of THIS server, e.g. https://teenwallet-api.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
# The app link this server forwards the parent to afterwards
APP_DEEP_LINK=teenwallet://paypal-return

# Demo conversion: PayPal is charged in USD, the wallet is in rupees
INR_PER_USD=85
APP_TIMEZONE=Asia/Kolkata
